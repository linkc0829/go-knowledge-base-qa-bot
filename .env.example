# ============================================================================
# Application
# ============================================================================
APP_PORT=12598
APP_SHUTDOWN_TIMEOUT=10s

# ============================================================================
# Authentication
# ============================================================================
# Required by cmd/kb unless KB_AUTH_DISABLED is explicitly true.
KB_AUTH_FILE=
# Local-only escape hatch; cmd/kb forces 127.0.0.1 when true.
KB_AUTH_DISABLED=false

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_ENCODING=json
# Comma-separated sinks: stdout, stderr, or a file path. Keep the file sink —
# the kb_query lines are the only record of what the KB was asked (token usage
# is also in the gateway's gateway_usage log).
LOG_OUTPUT=stdout,log/kb.log

# ============================================================================
# OpenAI-compatible LLM
# ============================================================================
# A trusted gateway service token (kbtoken create -trusted -workload rag).
OPENAI_API_KEY=
KB_LLM_MODE=openai
# Chat and embeddings both go through the gateway.
OPENAI_BASE_URL=http://localhost:12599/v1
KB_CHAT_MODEL=gemma-4-26b-a4b
# Decoding parameters. Unset, the upstream falls back to the served model's own
# generation_config (Gemma defaults to temperature 1.0), which makes repeated
# eval rounds disagree with each other. Grounded QA wants greedy decoding.
KB_CHAT_TEMPERATURE=0
# 0 omits max_tokens. Answers cite their sources in the closing lines, so a
# limit that truncates costs the citation, not just prose.
KB_CHAT_MAX_TOKENS=1024
# Sent as reasoning_effort (none/low/medium/high). Empty omits it and the served
# model decides: Gemma 4 does not think, K2 Horizon thinks at high. On K2 only
# none and high parse cleanly; low/medium leak thinking tags into the answer.
KB_CHAT_REASONING_EFFORT=
# Must equal GATEWAY_EMBED_MODEL, or the gateway rejects every embedding.
KB_EMBED_MODEL=gemini-embedding-2
KB_DOCS_DIR=docs
KB_INDEX_DIR=.kb
# Forward caller principal ID to internal gateway via X-On-Behalf-Of header.
# Only enable when OPENAI_BASE_URL targets the internal Gateway, never public cloud.
KB_LLM_FORWARD_USER=true
# Optional timeout for POST /index operations. Server WriteTimeout scales with this value (defaults to 60s).
# Set to 10m when rebuilding index during embedding model migration.
KB_INDEX_TIMEOUT=
# Optional timeout for one POST /chat (retrieval + model answer), default 30s.
# Raise it for reasoning models: thinking can push the slowest answers past 30s.
KB_CHAT_TIMEOUT=

# ============================================================================
# API Gateway (cmd/gateway)
# ============================================================================
# Required chat upstream base URL. A trailing /v1 is optional; the gateway strips it.
GATEWAY_UPSTREAM_BASE_URL=
GATEWAY_UPSTREAM_API_KEY=
GATEWAY_UPSTREAM_HEADER_TIMEOUT=300s
GATEWAY_MAX_INFLIGHT=64
GATEWAY_MAX_INFLIGHT_PER_USER=4
GATEWAY_PORT=12599
GATEWAY_LOG_OUTPUT=stdout,log/gateway.log
# Optional dedicated embedding upstream: the full OpenAI-compatible base URL
# including its version path (Google's is /v1beta/openai). Requires
# GATEWAY_EMBED_MODEL. When omitted, embeddings go to GATEWAY_UPSTREAM_BASE_URL.
GATEWAY_EMBED_UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GATEWAY_EMBED_UPSTREAM_API_KEY=
# Embedding model name bound to /v1/embeddings: any other name, or a body without
# one, gets 400 and is never forwarded. It checks the requested name only, not
# the model the backend loaded. Must equal KB_EMBED_MODEL.
# Rule: a new model gets a new name; never reuse a name for a different model.
GATEWAY_EMBED_MODEL=gemini-embedding-2

# cp .env.example .env && chmod 600 .env   — never commit .env
# Which model runs: gemma (vllm) or k2 (llama.cpp). Without it nothing starts.
COMPOSE_PROFILES=gemma
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
MODEL_ID=RedHatAI/gemma-4-26B-A4B-it-FP8-dynamic
MODEL_REVISION=ed35d7abe5d940da41b4ff06eb482feb0be8cb44
SERVED_MODEL_NAME=gemma-4-26b-a4b
# Secret: openssl rand -hex 32. The platform .env's VLLM_API_KEY must match.
VLLM_API_KEY=
# Optional: this checkpoint is not gated.
HF_TOKEN=
VLLM_MAX_MODEL_LEN=98304
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_NUM_SEQS=4
HF_CACHE_DIR=/srv/ai/hf-cache
VLLM_CACHE_DIR=/srv/ai/vllm-cache
# k2 profile only (SERVED_MODEL_NAME above becomes k2-horizon).
K2_IMAGE=local/llama-k2:42adf01
K2_GGUF=K2-Horizon-MoVA-36B-A4B-Q6_K.gguf
K2_CTX=163840
GGUF_DIR=/srv/ai/gguf

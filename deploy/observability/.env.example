# cp .env.example .env && chmod 600 .env   — never commit .env
DATA_DIR=/srv/ai/observability/data
PLATFORM_LOG_DIR=/srv/ai/platform/data/log
# GID of the host's ailogs group (Ansible creates it): getent group ailogs
AILOGS_GID=
# Secret: openssl rand -base64 24. Sent in cleartext over the LAN until TLS.
GRAFANA_ADMIN_PASSWORD=
# SMTP & Alerting (emails sent to ALERT_EMAIL_TO when ready_probe or SLO rules fire)
GRAFANA_SMTP_HOST=
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=
# true only while the relay's certificate cannot be verified; keep false otherwise
GRAFANA_SMTP_SKIP_VERIFY=false
ALERT_EMAIL_TO=
GRAFANA_ROOT_URL=http://localhost:3000

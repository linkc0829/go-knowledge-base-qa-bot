# cp .env.example .env && chmod 600 .env   — never commit .env
DATA_DIR=/srv/ai/platform/data
# Secret: same value as VLLM_API_KEY in deploy/inference/.env.
VLLM_API_KEY=
# Secret: Google AI key for embeddings (gateway only).
GEMINI_API_KEY=
# Secret: the KB's trusted gateway token (kbtoken create -trusted -workload rag).
KB_GATEWAY_TOKEN=
SERVED_MODEL_NAME=gemma-4-26b-a4b
KB_EMBED_MODEL=gemini-embedding-2
GATEWAY_MAX_INFLIGHT=64
GATEWAY_MAX_INFLIGHT_PER_USER=4
